<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the simulation outside Unity: the trace runner that checks it against the JavaScript prototype.
       C# 9, as Unity 6 compiles it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0649;CS0414</NoWarn>
    <!-- (ShieldTests is its own project) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);ShieldTests/**;typecheck/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Assets/NovaStriker/Sim/**/*.cs" />
  </ItemGroup>
</Project>
